{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "version": "1.0.2",
  "minimum_chrome_version": "118",
  "description": "__MSG_description__",
  "permissions": [
    "activeTab",
    "scripting",
    "debugger",
    "storage",
    "alarms"
  ],
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "default_locale": "en",
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  }
}
