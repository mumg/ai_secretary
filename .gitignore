.DS_Store
.env
.idea/
.vscode/
*.har
*.pcap
*.pcapng
*.log
*.dump
*.sql
*.sqlite*
*.db
.pytest_cache/
.ruff_cache/
.mypy_cache/
__pycache__/
*.py[cod]
*.egg-info/
.venv/
node_modules/
dist/
build/
/backend/web/downloads/

# Runtime data and secrets
/data/
/.upgrade-backups/
secrets/*
!secrets/.gitkeep
!secrets/README.md
config/config.yaml
compose.letsencrypt.yaml

# Private keys and certificates must never enter Git, regardless of location.
*.key
*.pem
*.crt
*.cer
*.p12
*.pfx

# Android
android/.gradle/
android/local.properties
android/secretary.local.properties
android/**/build/
*.jks
*.keystore
google-services.json
/android/.kotlin/
/dataPack*.json
/extensions/

# Embedded Go migrations are source code.
!/backend/internal/store/migrations/*.sql

# iOS local build state and Firebase configuration
# iOS is maintained in its own Git repository.
/ios/
ios/build/
ios/GoogleService-Info.plist
ios/**/*.xcuserstate
ios/**/xcuserdata/
/android/rustore/
