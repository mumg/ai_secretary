COMPOSE_PROJECT_NAME=improver
POSTGRES_DB=improver
POSTGRES_USER=improver
POSTGRES_PASSWORD_FILE=/run/secrets/postgres_password
DATABASE_URL=postgresql+asyncpg://improver@db:5432/improver
DATABASE_PASSWORD_FILE=/run/secrets/postgres_password
DATA_DIR=/data
APP_MASTER_KEY_FILE=/run/secrets/app_master_key
PUBLIC_HOST=secretary.example.com
SERVER_CERT_FILE=/certs/server.crt
SERVER_KEY_FILE=/certs/server.key
CLIENT_CA_FILE=/certs/client-ca.crt
LOG_LEVEL=INFO
